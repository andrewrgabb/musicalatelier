# =============================================================================
# Musical Atelier — environment template
# =============================================================================
# Copy this file to `.env` (which is gitignored) and fill in real values.
# Local development works with the defaults below — they match the services
# defined in docker-compose.yml. Only the cloud values (prod) need secrets.
#
# The golden rule of this template: LOCAL and PROD differ ONLY by these values
# (endpoints + credentials). The same code runs against both.
#   MinIO  <-> Cloudflare R2
#   local Postgres <-> Fly Managed Postgres
#   local Redis    <-> Fly-managed Upstash Redis
#   Clerk dev      <-> Clerk prod
# =============================================================================

# ----- Shared by API (Node) and Worker (Python) -----------------------------

# Redis connection (BullMQ queue). MUST be a redis:// TCP URL (ioredis).
# Never use Upstash's HTTP/REST client for BullMQ.
# Local: matches the `redis` service in docker-compose.yml.
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible). Local points at MinIO; prod points at R2.
R2_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=musical-atelier
# For real R2 you also set the region to "auto"; MinIO ignores it.
R2_REGION=auto
# MinIO needs path-style URLs (bucket in the path, not the host). R2 supports
# both; we use path-style everywhere so one setting works locally and in prod.
R2_FORCE_PATH_STYLE=true

# ----- API (Node) only -------------------------------------------------------

# Postgres connection used by Prisma AT RUNTIME (pooled, via PgBouncer).
# Local Postgres has no PgBouncer, so the ?pgbouncer flag is omitted locally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/musical_atelier

# Postgres connection used by Prisma FOR MIGRATIONS (direct, no pooler).
# Migrations need advisory locks that a pooler can't carry through.
# Locally this is the same as DATABASE_URL; in prod it's the direct string.
# The Python WORKER also uses this (direct) connection to mirror job status.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/musical_atelier

# CORS allow-list — the origin(s) the browser SPA is served from. Single origin
# locally; in prod you can pass a comma-separated list (e.g. apex + www).
APP_ORIGIN=http://localhost:5173

# Port the API listens on.
PORT=8080

# Bull Board (the queue dashboard at /admin/queues) is guarded by HTTP Basic
# auth ONLY when both of these are set. Leave them blank locally (open); you
# MUST set them in production.
BULLBOARD_USER=
BULLBOARD_PASS=

# --- Auth (Clerk) — REQUIRED ---
# Auth is always real: the API verifies each request's JWT against the issuer's
# JWKS. Set up a free Clerk app (https://clerk.com) — takes a couple of minutes:
#   1. Create an application, then open "API keys".
#   2. Copy the Publishable key (pk_test_... for a dev instance) below.
#   3. The Frontend API URL is encoded in that key; it's also shown on the same
#      page. Use it as CLERK_ISSUER, and CLERK_ISSUER + /.well-known/jwks.json
#      as CLERK_JWKS_URL.
# The backend only needs the issuer + JWKS URL (no secret key — verification is
# done with public keys). The adapter is provider-agnostic: point these at
# WorkOS/Auth0/etc. and it works the same.
CLERK_ISSUER=https://<your-subdomain>.clerk.accounts.dev
CLERK_JWKS_URL=https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
# Frontend (Vite) needs the publishable key to render Clerk's sign-in UI.
# Prefixed VITE_ so it's exposed to the browser bundle (it's a public value).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Worker (Python) only --------------------------------------------------

# The worker runs the Audiveris OMR engine (Java + Tesseract) via its batch CLI,
# then converts the MusicXML output to MIDI. Audiveris handles PDFs and images
# natively. It must be installed locally — see apps/worker/README.md.

# Path to the Audiveris launcher. The Docker image sets this to its bundled
# install; locally point it at your install, e.g. the macOS app bundle:
#   AUDIVERIS_CMD=/Applications/Audiveris.app/Contents/MacOS/Audiveris
AUDIVERIS_CMD=
# Max seconds to allow a single Audiveris run before giving up.
AUDIVERIS_TIMEOUT_SECONDS=600
# Where Tesseract's language data (eng.traineddata) lives. Only set if Audiveris
# can't find it on its own, e.g. on macOS with Homebrew tesseract:
#   TESSDATA_PREFIX=/opt/homebrew/share/tessdata
# TESSDATA_PREFIX=

# ----- Frontend (web, Vite) --------------------------------------------------
# Where the SPA finds the API. Local: the Express dev server.
VITE_API_URL=http://localhost:8080
