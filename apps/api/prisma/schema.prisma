// Prisma schema — the database "blueprint" for Musical Atelier.
//
// Prisma is our ORM (Object-Relational Mapper): we describe tables here as
// code, Prisma generates a type-safe TypeScript client to query them, and it
// turns changes to this file into versioned SQL migrations committed to the
// repo. The API (Node) is the SOLE owner of the schema + migrations.
//
// Two connection URLs (see the datasource block):
//   url       -> used at RUNTIME. In prod this is the POOLED connection
//                (PgBouncer, ?pgbouncer=true) so many requests share a small
//                pool of real DB connections.
//   directUrl -> used for MIGRATIONS only. Migrations need advisory locks that
//                a connection pooler can't carry through, so they go direct.
// Locally both point at the same plain Postgres container.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// A user of the app. Identity itself lives with the auth provider (Clerk);
// this is our LOCAL record so the rest of the schema can foreign-key to a
// stable internal id instead of the provider's id format.
model User {
  // Internal primary key — everything else references THIS, never the Clerk id.
  id String @id @default(cuid())

  // The auth provider's user id (e.g. Clerk's "user_..."). We upsert on this at
  // first login. Swapping providers later changes only how this is populated.
  externalAuthId String @unique @map("external_auth_id")

  email String?

  scores Score[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// What kind of file the user uploaded.
enum SourceType {
  image
  pdf
}

// The lifecycle of a transcription attempt. Mirrors the ScoreStatus type in
// packages/contracts. The Postgres row is the user-facing source of truth;
// BullMQ holds the in-flight job and the worker mirrors progress into here.
enum ScoreStatus {
  queued
  processing
  completed
  failed
}

// One uploaded score = the source file. The actual transcription(s) live in
// Attempt rows: a score can be (re)processed many times with different options,
// and we keep every run as a separate attempt so results can be compared.
model Score {
  id String @id @default(cuid())

  // Owner — foreign key to our internal users.id (never the Clerk id).
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // R2/MinIO object key of the uploaded image/PDF.
  sourceKey  String     @map("source_key")
  sourceType SourceType @map("source_type")

  // Every transcription run of this source (newest first when loaded).
  attempts Attempt[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("scores")
}

// One transcription run of a score's source. Re-processing creates a new
// Attempt instead of overwriting, so a score accumulates a version history.
model Attempt {
  id String @id @default(cuid())

  // The score (source) this run belongs to.
  scoreId String @map("score_id")
  score   Score  @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  // Which OMR engine actually ran ("audiveris" | "homr"). Set by the worker.
  engine String?

  // The transcription options used for this run (curated set; null = defaults).
  options Json?

  // Lifecycle + progress, mirrored from the worker.
  status   ScoreStatus @default(queued)
  progress Int         @default(0) // 0–100

  // R2/MinIO object keys of the generated outputs (set on success).
  outputKey     String? @map("output_key") // MusicXML
  outputMidiKey String? @map("output_midi_key") // MIDI

  // Failure message (set on failure).
  error String?

  // The BullMQ job id, so we can correlate the row with the queue.
  jobId String? @map("job_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([scoreId])
  @@map("attempts")
}
