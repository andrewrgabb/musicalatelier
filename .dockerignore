# Keep build contexts small AND correct. Excluding node_modules/.venv forces a
# fresh in-image install so native binaries match the Linux image (not your Mac).
**/node_modules
**/.venv
**/dist
**/build
**/.turbo
**/*.tsbuildinfo
**/.vite

# Never bake secrets or local-only files into an image.
.env
.env.*
!.env.example

# Python / caches
**/__pycache__
**/*.pyc
apps/worker/.cache

# VCS / editor / OS
.git
.gitignore
.idea
.vscode
.DS_Store

# Docs aren't needed at runtime
**/*.md
